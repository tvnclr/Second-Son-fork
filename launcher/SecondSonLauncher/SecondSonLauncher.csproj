<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SecondSonLauncher</AssemblyName>
    <RootNamespace>SecondSonLauncher</RootNamespace>
    <Version>0.1.0</Version>
    <Product>inFAMOUS Second Son Launcher</Product>
    <Copyright>GPL-2.0-or-later</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- The game's own icon, made from the player's dump (sce_sys\icon0.png). publish.ps1 copies it here
       from the play folder; it is game art, so it stays out of the repository (.gitignore). -->
  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="Exists('app.ico')">
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
