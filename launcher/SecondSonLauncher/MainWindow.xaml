<Window x:Class="SecondSonLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SecondSonLauncher.Views"
        Title="{Binding GameTitle, StringFormat='{}{0} - Launcher'}"
        Width="1240" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left rail -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
                    <RadioButton Style="{StaticResource RailButton}" ToolTip="Home" AutomationProperties.Name="Home"
                                 IsChecked="{Binding Page, Converter={StaticResource EqualsToBool}, ConverterParameter=Home}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="20"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailButton}" ToolTip="Settings" AutomationProperties.Name="Settings"
                                 IsChecked="{Binding Page, Converter={StaticResource EqualsToBool}, ConverterParameter=Settings}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="20"/>
                    </RadioButton>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version}" Foreground="{StaticResource FaintTextBrush}"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            </DockPanel>
        </Border>

        <views:HomeView Grid.Column="1"
                        Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Home}"/>
        <views:SettingsView Grid.Column="1"
                            Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Settings}"/>
    </Grid>
</Window>
